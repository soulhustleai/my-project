# Surplus Funds Recovery — Environment Variables
# Copy to .env and fill in values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# Lob (Direct Mail)
# Secret key for sending mail (starts with live_ or test_)
LOB_API_KEY=
# Publishable key for address verification (starts with live_pub_ or test_pub_)
LOB_PUBLISHABLE_KEY=
LOB_TEST_MODE=false

# Twilio (SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# People Data Labs (Enrichment)
PDL_API_KEY=...

# Business Info
BUSINESS_NAME=
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_WEBSITE=

# Scoring
MIN_SURPLUS_AMOUNT=1000
MIN_SCORE_TO_ENRICH=20
MIN_SURPLUS_FOR_PHONE=10000
MAX_ENRICHMENTS_PER_DAY=100

# Sentry (Error Monitoring)
SENTRY_DSN=
